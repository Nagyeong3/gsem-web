# 프론트 데이터 접근 방식: mock 또는 http
VITE_DATA_SOURCE=mock

# HTTP 모드에서 사용할 개발 API 주소
VITE_API_BASE_URL=http://127.0.0.1:4010/api/v1

# FastAPI 개발 서버
GSEM_API_HOST=127.0.0.1
GSEM_API_PORT=4010
GSEM_API_LOG=1

# 백엔드 데이터 접근 방식: memory 또는 sqlserver
# 실제 DB 연결 전에는 memory를 사용하고, SQL Server 조회 연동 검증 시 sqlserver로 변경합니다.
GSEM_DATA_SOURCE=memory

# SQL Server 접속 정보: 비밀번호는 실제 .env에만 입력하고 저장소에 커밋하지 않습니다.
GSEM_DB_HOST=166.103.117.105
GSEM_DB_PORT=1433
GSEM_DB_NAME=GSEMS
GSEM_DB_USER=
GSEM_DB_PASSWORD=
GSEM_DB_DRIVER=ODBC Driver 17 for SQL Server
GSEM_DB_ENCRYPT=yes
GSEM_DB_TRUST_SERVER_CERTIFICATE=yes
GSEM_DB_TIMEOUT_SECONDS=5
